# ==============================================================================
# AskItAll - Enterprise Multimodal Knowledge Intelligence Platform
# Environment Configuration Template
# ==============================================================================

# Application
APP_NAME=AskItAll
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=generate-a-secure-32-byte-hex-key-here-for-production
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Authentication & JWT
JWT_SECRET_KEY=change-this-super-secret-jwt-key-for-askitall-platform
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# PostgreSQL + pgvector
POSTGRES_USER=askitall
POSTGRES_PASSWORD=askitall_password
POSTGRES_DB=askitall_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://askitall:askitall_password@postgres:5432/askitall_db
DATABASE_URL_SYNC=postgresql+psycopg2://askitall:askitall_password@postgres:5432/askitall_db

# Redis & Celery
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PORT_HOST=6380
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Neo4j Graph Database
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=askitall_graph_password
NEO4J_DATABASE=neo4j

# Storage Provider (local | cloudinary | s3)
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=/app/uploads

# Cloudinary (Optional - for dev/cloud storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AWS S3 (Production storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=askitall-enterprise-knowledge

# AI Gateway & LLM Providers
DEFAULT_LLM_PROVIDER=gemini
DEFAULT_LLM_MODEL=gemini-1.5-pro
DEFAULT_EMBEDDING_PROVIDER=gemini
DEFAULT_EMBEDDING_MODEL=text-embedding-004

GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Reranker Provider (cross-encoder | cohere | local)
RERANKER_PROVIDER=local
COHERE_API_KEY=

# Observability
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
LOG_LEVEL=INFO
